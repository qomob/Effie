{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Claim record",
 "type": "object",
 "required": [
  "claim_id",
  "text",
  "type",
  "evidence_ids"
 ],
 "properties": {
  "claim_id": {
   "type": "string"
  },
  "text": {
   "type": "string"
  },
  "type": {
   "enum": [
    "FACT",
    "CLAIM",
    "CALC",
    "INFERENCE",
    "RECOMMENDATION",
    "UNKNOWN"
   ]
  },
  "evidence_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "value": {},
  "unit": {
   "type": "string"
  },
  "period": {
   "type": "string"
  },
  "scope": {
   "type": "string"
  },
  "formula": {
   "type": "string"
  },
  "supports": {
   "type": "boolean"
  }
 }
}